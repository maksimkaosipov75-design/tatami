_backup/*
!_backup/.gitkeep
!_backup/registry-undo.ps1

# YASB writes its own runtime log into its config dir (which is this repo,
# via symlink) - not source-controlled content.
yasb/*.log
yasb/*.log.*

# API keys for YASB widgets. Committed configs reference them as
# "$env:NAME"; .env.example documents the format.
yasb/.env

# .NET build artifacts for the dock app - regenerated by `dotnet build`.
dock/bin/
dock/obj/
dock/publish/
dock/*.log

# Installer build output. The payload zip is regenerated from the dotfiles tree
# on every build, so it is never source-controlled.
installer/bin/
installer/obj/
installer/dist/

# Live dock state, rewritten on every slider drag in the settings window.
# The dock falls back to its built-in defaults when the file is absent, so
# there is nothing to ship - the installer does not carry it either.
dock/settings.json
