<Window x:Class="OmarchySetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Omarchy for Windows — Setup"
        Height="720" Width="860"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e2e">

    <Window.Resources>
        <SolidColorBrush x:Key="Text" Color="#cdd6f4" />
        <SolidColorBrush x:Key="Subtext" Color="#a6adc8" />
        <SolidColorBrush x:Key="Mauve" Color="#cba6f7" />
        <SolidColorBrush x:Key="Surface" Color="#313244" />
        <SolidColorBrush x:Key="Mantle" Color="#181825" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Omarchy for Windows" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="A tiling, keyboard-driven desktop: GlazeWM + YASB + a macOS-style dock, themed Catppuccin Mocha."
                       Foreground="{StaticResource Subtext}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Mantle}" CornerRadius="10" Padding="6" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ComponentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="10,8" CornerRadius="8" Margin="2">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  Foreground="{StaticResource Text}"
                                                  FontWeight="SemiBold"
                                                  FontFamily="Segoe UI"
                                                  Content="{Binding Title}" />
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{StaticResource Subtext}"
                                                   FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   Margin="24,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Mantle}" CornerRadius="10" Padding="10" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Install log" FontWeight="SemiBold" Margin="4,2,0,8" />
                    <ScrollViewer Grid.Row="1" x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="LogBox"
                                 Background="Transparent"
                                 Foreground="{StaticResource Subtext}"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="11.5"
                                 TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Subtext}"
                       FontSize="12"
                       Text="Choose what to install, then press Install." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SelectAllButton" Content="Select all" Click="SelectAll_Click"
                        Padding="14,8" Margin="0,0,8,0" Background="{StaticResource Surface}"
                        Foreground="{StaticResource Text}" BorderThickness="0" FontFamily="Segoe UI" />
                <Button x:Name="InstallButton" Content="Install" Click="Install_Click"
                        Padding="28,8" Background="{StaticResource Mauve}"
                        Foreground="#1e1e2e" BorderThickness="0" FontWeight="SemiBold" FontFamily="Segoe UI" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
