<Window x:Class="TatamiSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tatami for Windows — Setup"
        Height="720" Width="860"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e2e">

    <Window.Resources>
        <SolidColorBrush x:Key="Text" Color="#cdd6f4" />
        <SolidColorBrush x:Key="Subtext" Color="#a6adc8" />
        <SolidColorBrush x:Key="Mauve" Color="#cba6f7" />
        <SolidColorBrush x:Key="Surface" Color="#313244" />
        <SolidColorBrush x:Key="Mantle" Color="#181825" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <!-- The brand mark, drawn inline so the installer stays a single
                 self-contained exe with no image assets to resolve at runtime.
                 Same geometry as docs/brand/icon.svg. -->
            <Viewbox Width="64" Height="64" VerticalAlignment="Top" Margin="0,2,16,0">
                <Canvas Width="512" Height="512">
                    <Border Width="512" Height="512" CornerRadius="116" Background="#1e1e2e" />
                    <Border Canvas.Left="96" Canvas.Top="86" Width="320" Height="26" CornerRadius="13" Background="#6c7086" />
                    <Border Canvas.Left="96" Canvas.Top="140" Width="176" Height="244" CornerRadius="22" Background="#cba6f7" />
                    <Border Canvas.Left="288" Canvas.Top="140" Width="128" Height="114" CornerRadius="22" Background="#89b4fa" />
                    <Border Canvas.Left="288" Canvas.Top="270" Width="128" Height="114" CornerRadius="22" Background="#a6e3a1" />
                    <Ellipse Canvas.Left="199" Canvas.Top="415" Width="26" Height="26" Fill="#cdd6f4" />
                    <Ellipse Canvas.Left="243" Canvas.Top="415" Width="26" Height="26" Fill="#cdd6f4" />
                    <Ellipse Canvas.Left="287" Canvas.Top="415" Width="26" Height="26" Fill="#cdd6f4" />
                </Canvas>
            </Viewbox>

            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="26">
                    <Run Text="Tatami" FontWeight="SemiBold" />
                    <Run Text="for Windows" Foreground="{StaticResource Subtext}" FontWeight="Light" />
                </TextBlock>
                <TextBlock Text="Tiling window manager, dock and status bar — in one installer. Themed Catppuccin Mocha."
                           Foreground="{StaticResource Subtext}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Mantle}" CornerRadius="10" Padding="6" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ComponentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="10,8" CornerRadius="8" Margin="2">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  Foreground="{StaticResource Text}"
                                                  FontWeight="SemiBold"
                                                  FontFamily="Segoe UI"
                                                  Content="{Binding Title}" />
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{StaticResource Subtext}"
                                                   FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   Margin="24,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Mantle}" CornerRadius="10" Padding="10" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Install log" FontWeight="SemiBold" Margin="4,2,0,8" />
                    <ScrollViewer Grid.Row="1" x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="LogBox"
                                 Background="Transparent"
                                 Foreground="{StaticResource Subtext}"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="11.5"
                                 TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Subtext}"
                       FontSize="12"
                       Text="Choose what to install, then press Install." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SelectAllButton" Content="Select all" Click="SelectAll_Click"
                        Padding="14,8" Margin="0,0,8,0" Background="{StaticResource Surface}"
                        Foreground="{StaticResource Text}" BorderThickness="0" FontFamily="Segoe UI" />
                <Button x:Name="InstallButton" Content="Install" Click="Install_Click"
                        Padding="28,8" Background="{StaticResource Mauve}"
                        Foreground="#1e1e2e" BorderThickness="0" FontWeight="SemiBold" FontFamily="Segoe UI" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
