<Window x:Class="OmarchyDock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:OmarchyDock.Services"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Dock settings"
        Width="520" Height="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource BaseBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MauveBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Overlay0Brush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Dock settings" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Changes apply as you make them. Nothing here needs a restart." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel Margin="0,0,12,0">

                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}" />

                <TextBlock><Run Text="Icon size" /><Run Text=" " /><Run Text="{Binding IconSize, StringFormat={}{0} px}" Foreground="{DynamicResource Overlay0Brush}" /></TextBlock>
                <Slider Minimum="24" Maximum="96" TickFrequency="2" Value="{Binding IconSize}" />

                <TextBlock Margin="0,10,0,0"><Run Text="Spacing between icons" /><Run Text=" " /><Run Text="{Binding IconSpacing, StringFormat={}{0} px}" Foreground="{DynamicResource Overlay0Brush}" /></TextBlock>
                <Slider Minimum="0" Maximum="24" TickFrequency="1" Value="{Binding IconSpacing}" />

                <TextBlock Margin="0,10,0,0"><Run Text="Corner radius" /><Run Text=" " /><Run Text="{Binding CornerRadius, StringFormat={}{0} px}" Foreground="{DynamicResource Overlay0Brush}" /></TextBlock>
                <Slider Minimum="0" Maximum="40" TickFrequency="1" Value="{Binding CornerRadius}" />

                <TextBlock Margin="0,10,0,0"><Run Text="Background opacity" /><Run Text=" " /><Run Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}" Foreground="{DynamicResource Overlay0Brush}" /></TextBlock>
                <Slider Minimum="0.1" Maximum="1.0" TickFrequency="0.01" Value="{Binding BackgroundOpacity}" />

                <TextBlock Text="Running app indicator" Margin="0,12,0,0" />
                <ComboBox x:Name="IndicatorBox" SelectedValue="{Binding RunningIndicator}" SelectedValuePath="Tag">
                    <ComboBoxItem Content="None">
                        <ComboBoxItem.Tag><services:RunningIndicator>None</services:RunningIndicator></ComboBoxItem.Tag>
                    </ComboBoxItem>
                    <ComboBoxItem Content="Dot">
                        <ComboBoxItem.Tag><services:RunningIndicator>Dot</services:RunningIndicator></ComboBoxItem.Tag>
                    </ComboBoxItem>
                    <ComboBoxItem Content="Line">
                        <ComboBoxItem.Tag><services:RunningIndicator>Line</services:RunningIndicator></ComboBoxItem.Tag>
                    </ComboBoxItem>
                </ComboBox>

                <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionHeader}" />

                <CheckBox Content="Hide the dock until the cursor reaches the screen edge"
                          IsChecked="{Binding AutoHide}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Off keeps the dock on screen at all times." />

                <CheckBox Content="Stay hidden over fullscreen apps"
                          IsChecked="{Binding HideOverFullscreen}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="The dock is topmost, so without this it draws over fullscreen games and video." />

                <CheckBox Content="Hide the Windows taskbar"
                          IsChecked="{Binding HideWindowsTaskbar}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Hides the taskbar window only; explorer.exe keeps running as the shell. Restored automatically if the dock exits." />

                <TextBlock Text="EFFECTS" Style="{StaticResource SectionHeader}" />

                <CheckBox Content="Magnify icons on hover" IsChecked="{Binding MagnifyOnHover}" />
                <TextBlock Margin="0,8,0,0"><Run Text="Magnification" /><Run Text=" " /><Run Text="{Binding MagnifyScale, StringFormat={}{0:0.00}×}" Foreground="{DynamicResource Overlay0Brush}" /></TextBlock>
                <Slider Minimum="1.0" Maximum="2.0" TickFrequency="0.05"
                        Value="{Binding MagnifyScale}" IsEnabled="{Binding MagnifyOnHover}" />

                <CheckBox Content="Genie animation when minimising" Margin="0,14,0,0"
                          IsChecked="{Binding GenieEnabled}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Off falls back to the plain Windows minimise animation." />

                <TextBlock Margin="0,8,0,0"><Run Text="Genie duration" /><Run Text=" " /><Run Text="{Binding GenieDurationMs, StringFormat={}{0} ms}" Foreground="{DynamicResource Overlay0Brush}" /></TextBlock>
                <Slider Minimum="120" Maximum="1200" TickFrequency="10"
                        Value="{Binding GenieDurationMs}" IsEnabled="{Binding GenieEnabled}" />

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Reset to defaults" HorizontalAlignment="Left" Click="Reset_Click"
                    Padding="14,7" Background="{DynamicResource Surface0Brush}"
                    Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontFamily="Segoe UI" />
            <Button Content="Close" HorizontalAlignment="Right" Click="Close_Click"
                    Padding="28,7" Background="{DynamicResource MauveBrush}"
                    Foreground="{DynamicResource BaseBrush}" BorderThickness="0"
                    FontWeight="SemiBold" FontFamily="Segoe UI" />
        </Grid>
    </Grid>
</Window>
