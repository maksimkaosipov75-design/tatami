<Window x:Class="OmarchyDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:OmarchyDock.Converters"
        Title="OmarchyDock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Window.Resources>
        <conv:ForegroundToBrushConverter x:Key="ForegroundToBrushConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <!-- Sizes and radii come from DynamicResource so the settings window can
             change them on a live dock. Hover magnification is animated from
             code-behind rather than a Style trigger: a Storyboard inside a Style
             gets frozen, so its To value can't follow a DynamicResource. -->
        <Style x:Key="DockIconStyle" TargetType="Border">
            <Setter Property="Width" Value="{DynamicResource IconSize}" />
            <Setter Property="Height" Value="{DynamicResource IconSize}" />
            <Setter Property="Margin" Value="{DynamicResource IconMargin}" />
            <Setter Property="CornerRadius" Value="{DynamicResource IconCornerRadius}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RenderTransformOrigin" Value="0.5,1" />
            <!-- No RenderTransform here on purpose: a Freezable set from a Style
                 is sealed, and animating a frozen transform throws. The hover
                 code attaches a live one per icon instead. -->
        </Style>
    </Window.Resources>

    <!-- Transparent headroom above the bar. Icons scale up on hover and lift
         further while being dragged, and anything drawn past the window's own
         bounds is clipped away - without this the top of a magnified icon was
         cut off at the dock's edge. The window is positioned by its total
         height, so the visible bar stays where it was. -->
    <Border x:Name="DockBorder"
            Background="{DynamicResource DockBackgroundBrush}"
            CornerRadius="{DynamicResource DockCornerRadius}"
            Padding="10,8"
            Margin="0,44,0,0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="DockSlide" Y="0" />
        </Border.RenderTransform>
        <ItemsControl x:Name="ItemsHost" ItemsSource="{Binding}"
                      PreviewMouseMove="Dock_MouseMove"
                      PreviewMouseLeftButtonUp="Dock_MouseUp">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Border Style="{StaticResource DockIconStyle}"
                                Background="{Binding IsForeground, Converter={StaticResource ForegroundToBrushConverter}}"
                                MouseLeftButtonUp="DockIcon_Click"
                                PreviewMouseLeftButtonDown="DockIcon_MouseDown"
                                MouseEnter="DockIcon_MouseEnter"
                                MouseLeave="DockIcon_MouseLeave"
                                Tag="{Binding}"
                                ToolTip="{Binding DisplayName}">
                            <Border.ContextMenu>
                                <ContextMenu Opened="DockMenu_Opened">
                                    <MenuItem Header="Keep in Dock"
                                              IsCheckable="True"
                                              IsChecked="{Binding IsPinned, Mode=OneWay}"
                                              Click="TogglePin_Click" />
                                    <MenuItem Tag="notiling"
                                              Header="Don't tile this app"
                                              IsCheckable="True"
                                              Click="ToggleTiling_Click" />
                                    <Separator />
                                    <MenuItem Header="Close window" Click="CloseWindow_Click" />
                                    <Separator />
                                    <MenuItem Tag="taskbar"
                                              Header="Hide the Windows taskbar"
                                              IsCheckable="True"
                                              Click="ToggleTaskbar_Click" />
                                    <MenuItem Header="Dock settings…" Click="OpenSettings_Click" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Image Source="{Binding Icon}"
                                   Width="{DynamicResource IconImageSize}"
                                   Height="{DynamicResource IconImageSize}"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <!-- Running indicator. Its shape is a Border rather than a
                             fixed Ellipse so the same element can be a dot or a
                             line depending on the setting; "None" collapses it
                             through the opacity resource. -->
                        <Border HorizontalAlignment="Center" Margin="0,2,0,0"
                                Width="{DynamicResource IndicatorWidth}"
                                Height="{DynamicResource IndicatorHeight}"
                                CornerRadius="{DynamicResource IndicatorCornerRadius}"
                                Opacity="{DynamicResource IndicatorOpacity}"
                                Background="{DynamicResource TextBrush}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
